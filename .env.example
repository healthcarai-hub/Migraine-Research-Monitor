# Copy to .env (git-ignored). Never commit real values. Every credential is optional: a present one switches on a provider or a higher tier.
DATABASE_URL=sqlite:///data/research_agent.sqlite
# For Supabase use the Session pooler URI (works over IPv4), e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
CONTACT_EMAIL=            # identifies this agent to NCBI and Crossref (polite pool); an address the operator reads

# ---- free tier
NCBI_API_KEY=             # PubMed: 10 requests/s instead of 3
OPENALEX_API_KEY=         # free key, about 10,000 credits a day
SPRINGER_API_KEY=         # Springer Nature Open Access API: full text of open access Springer / BMC / Nature papers

# ---- premium tier (code is in place; not yet tested against the live services because no keys exist)
OPENALEX_PLAN=free        # set to "premium" on a paid OpenAlex plan: exact created-date filtering (falls back by itself if refused)
CROSSREF_PLUS_TOKEN=      # Crossref Plus: higher rate limit
CROSSREF_MIN_INTERVAL=    # seconds between Crossref requests (default 1.0 public, 0.25 with a Plus token)
ELSEVIER_API_KEY=         # ScienceDirect full text; paywalled papers also need an institutional entitlement
ELSEVIER_INST_TOKEN=
WILEY_TDM_TOKEN=          # Wiley text-and-data-mining agreement: PDF full text

# ---- summaries: the Groq API, as in the earlier newsletter agent (same three setting names). Without LLM_MODEL and LLM_API_KEY the newsletter
# uses extracts of each paper's abstract instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=                # the Groq model name used before
LLM_REQUEST_INTERVAL_SECONDS=2.1   # Groq free tier; lower on a paid plan
LLM_MAX_RETRIES=6
LLM_REASONING_EFFORT=     # optional: low, medium or high, for reasoning models such as openai/gpt-oss-20b
LLM_MAX_SUMMARIES_PER_RUN=300

# ---- newsletter drafts (only needed for `newsletter publish --to gmail`; the file publisher needs nothing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEWSLETTER_RECIPIENTS=     # who the Gmail draft is addressed to, comma separated (kept out of git on purpose); the draft is never sent by the program
GOOGLE_REFRESH_TOKEN=     # made by `research-agent gmail authorize` (gmail.compose scope). The program only creates drafts and never sends; it cannot read the mailbox. Google's scope itself would allow sending
OUTPUTS_DIR=              # where the file publisher writes (default: ./outputs)

# ---- application API: search over the stored data, and the newsletter switches. It will not start without a token. Generate one with: research-agent api token
API_TOKENS=               # one or more tokens, comma separated; clients send 'Authorization: Bearer <token>'
API_ADMIN_TOKENS=         # tokens that may also switch topics/journals/researchers/sources on or off for the newsletter; empty = nobody can
API_ADMIN_DATABASE_URL=   # connection used for those switches (a role limited to the newsletter_selections table); default DATABASE_URL
API_DATABASE_URL=         # connection for all data routes (a read-only role, made by `research-agent db roles`); default DATABASE_URL
API_RATE_LIMIT_PER_MINUTE=120        # requests per client address per minute (0 = off)
API_AUTH_FAILURES_PER_MINUTE=10      # wrong tokens per address per minute before it is locked out for a while (0 = off)
API_CLIENT_IP_HEADER=    # the header your host's proxy sets to the visitor's address (Railway: X-Real-IP); check it with GET /v1/whoami. Empty = the connecting address
API_PROFILE=curt          # the profile the API serves
API_CORS_ORIGINS=         # browser front ends allowed to call it, comma separated (empty = none)
API_DOCS=                 # set to 1 to serve /docs and /openapi.json

# ---- routing
FULLTEXT_ORDER=           # optional, comma separated provider names to try first, e.g. wiley_tdm,elsevier_sciencedirect

# ---- scheduled jobs (`research-agent job daily|weekly`, run by the host's cron)
JOB_OVERLAP_DAYS=3        # how many days back the daily collection looks
JOB_FULLTEXT_LIMIT=500    # papers the weekly full-text pass handles per run
